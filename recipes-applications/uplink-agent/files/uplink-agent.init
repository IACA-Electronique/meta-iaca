#!/bin/sh

### BEGIN INIT INFO
# Provides:          uplink-agent
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Uplink agent - Remote control
# Description:       Starts the uplink agent daemon
### END INIT INFO

NAME=uplink-agent
WRAPPER=/usr/sbin/uplink-agent
DAEMON=/usr/share/uplink-agent/uplink-agent
PIDFILE=/var/run/$NAME.pid

case "$1" in
  start)
    echo "Starting $NAME..."
    start-stop-daemon --start --make-pidfile --pidfile $PIDFILE --background --exec $WRAPPER
    ;;
  stop)
    echo "Stopping $NAME..."
    start-stop-daemon --stop --exec $DAEMON --pidfile $PIDFILE --retry 5
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  status)
    start-stop-daemon --status --exec $DAEMON --pidfile $PIDFILE
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0
