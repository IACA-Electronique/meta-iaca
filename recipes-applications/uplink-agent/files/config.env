# Device serial number, required.
SN=99999999
# OS identifier in the form name:version, required.
OS_ID=b0e1a2c3-3333-4a2b-8c3d-000000000003
# Base URL of the uplink API, without trailing slash.
API_URL=https://api.uplink.iaca-electronique.com
# Seconds between two device reports.
EMIT_INTERVAL_SECS=5
# Network interface the MAC and IPv4 addresses are read from, defaults to eth0.
NETWORK_INTERFACE=eth0
# Bearer token sent as "Authorization: Bearer <TOKEN>" on every API request, required.
TOKEN=a1a126eb6197906e13d872ed9251ec9908a6e9810dfe08d104f00e8ea98caff6
