#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

exec </dev/console >/dev/console 2>&1

echo "Julien's initramfs ! (encryption 2)"

ROOTDEV=""

for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*)
            ROOTDEV="${arg#root=}"
            ;;
        encryptkey=*)
            ENCRYPTKEY="${arg#encryptkey=}"
            ;;
    esac
done

if [ -z "$ROOTDEV" ]; then
    echo "No root= found in /proc/cmdline"
    echo "Dropping to shell"
    exec /bin/sh
fi

if [ -z "$ENCRYPTKEY" ]; then
    echo "No encryptkey= found in /proc/cmdline"
    echo "Dropping to shell"
    exec /bin/sh
fi

echo "Root device from cmdline: $ROOTDEV"

MAPPER_ROOT_DEV_NAME=disk0
MAPPER_ROOT_DEV=/dev/mapper/${MAPPER_ROOT_DEV_NAME}

printf '%s' "$ENCRYPTKEY" | cryptsetup luksOpen "$ROOTDEV" "$MAPPER_ROOT_DEV_NAME" -d -

CRYPTSETUP_STATUS=$?

if [ "$CRYPTSETUP_STATUS" -ne 0 ]; then
    echo "cryptsetup luksOpen failed with status $CRYPTSETUP_STATUS"
    echo "Root device: $ROOTDEV"
    echo "Mapper name: $MAPPER_ROOT_DEV_NAME"
    echo "Available block devices:"
    ls -l /dev/mmcblk* /dev/sd* /dev/nvme* 2>/dev/null || true
    echo "Device mapper:"
    ls -l /dev/mapper 2>/dev/null || true
    echo "Loaded modules:"
    cat /proc/modules 2>/dev/null || true
    echo "Dropping to shell"
    exec /bin/sh
fi

if [ ! -e "$MAPPER_ROOT_DEV" ]; then
    echo "cryptsetup succeeded but $MAPPER_ROOT_DEV does not exist"
    ls -l /dev/mapper 2>/dev/null || true
    echo "Dropping to shell"
    exec /bin/sh
fi

mkdir -p /newroot

mount "$MAPPER_ROOT_DEV" /newroot

if [ $? -ne 0 ]; then
    echo "Failed to mount $ROOTDEV"
    echo "Available block devices:"
    ls -l /dev/mmcblk* 2>/dev/null || true
    echo "Dropping to shell"
    exec /bin/sh
fi

mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev

echo "Switching to real rootfs"

exec switch_root /newroot /sbin/init