#!/bin/sh
#
# rauc-service.init    Startup script for the RAUC D-Bus service (sysvinit)
#
# On sysvinit systems we start 'rauc service' directly at boot instead of
# relying on D-Bus service activation: when the activated process exits
# during startup (config load or slot-state determination failure), the
# bus only reports "Launch helper exited with unknown return code 1".

### BEGIN INIT INFO
# Provides:          rauc-service
# Required-Start:    $remote_fs $syslog dbus
# Required-Stop:     $remote_fs $syslog dbus
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: RAUC update service
# Description:       RAUC D-Bus service (de.pengutronix.rauc) used by
#                    'rauc status' / 'rauc install' and rauc-mark-good.
### END INIT INFO

PROG="/usr/bin/rauc"
NAME="rauc-service"
DESC="RAUC D-Bus service"
PIDFILE="/var/run/rauc-service.pid"
LOGFILE="/var/log/rauc-service.log"

[ -x "$PROG" ] || exit 0

RETVAL=0

start() {
    echo "Starting $NAME.."
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
            echo "already running (PID: $PID)"
            return 0
        fi
        rm -f "$PIDFILE"
    fi
    nohup "$PROG" service >> "$LOGFILE" 2>&1 &
    PID=$!
    RETVAL=$?
    [ $RETVAL -eq 0 ] && echo "$PID" > "$PIDFILE"
    echo "$NAME started."
}

stop() {
    if [ -f "$PIDFILE" ]; then
        echo "Stopping $NAME.."
        pid=$(cat "$PIDFILE")
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
            RETVAL=$?
            [ $RETVAL -eq 0 ] && rm -f "$PIDFILE"
            echo "$NAME stopped."
            return $RETVAL
        fi
    fi
    return 0
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ] && ps -p "$(cat "$PIDFILE")" > /dev/null 2>&1; then
        echo "$NAME (pid $(cat "$PIDFILE")) is running..."
        return 0
    fi
    echo "$NAME is stopped"
    return 3
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $RETVAL
