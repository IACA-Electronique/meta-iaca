#!/bin/sh
#
# rauc-usb-auto-upgrade.init    Startup script for RAUC USB Auto Upgrade Daemon
#
# This service monitors USB storage devices for RAUC update bundles.
# When a USB device with a FAT partition containing a specific identifier
# is detected, it mounts the partition, looks for last.raucb, and updates
# the system using RAUC, then powers off.

### BEGIN INIT INFO
# Provides:          rauc-usb-auto-upgrade
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: RAUC USB Auto Upgrade Daemon
# Description:       Monitors USB devices for RAUC update bundles and performs
#                    automatic system updates. Will poweroff after successful update.
### END INIT INFO

# Configuration
PROG="/usr/sbin/rauc-usb-auto-upgrade"
NAME="rauc-usb-auto-upgrade"
PIDFILE="/var/run/rauc-usb-auto-upgrade.pid"
LOGFILE="/var/log/rauc-usb-auto-upgrade.log"

[ -x "$PROG" ] || exit 0

RETVAL=0

start() {
    echo "Starting $NAME..."
    
    # Check if already running
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
            echo "already running (PID: $PID)"
            return 0
        fi
        # Stale PID file, remove it
        rm -f "$PIDFILE"
    fi
    
    # Ensure log file exists
    touch "$LOGFILE"
    chmod 666 "$LOGFILE"
    
    # Ensure mount point exists
    mkdir -p /mnt/rauc_update
    
    # Start the daemon
    start-stop-daemon --start --quiet --background --make-pidfile \
        --pidfile "$PIDFILE" --exec "$PROG" -- \
        >> "$LOGFILE" 2>&1
    
    RETVAL=$?
    
    if [ $RETVAL -eq 0 ]; then
        echo "$NAME started."
    else
        echo "Failed to start $NAME"
        rm -f "$PIDFILE"
    fi
    
    return $RETVAL
}

stop() {
    echo "Stopping $NAME..."
    
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
            start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --exec "$PROG"
            RETVAL=$?
            [ $RETVAL -eq 0 ] && rm -f "$PIDFILE"
            
            # Ensure cleanup - unmount if needed
            if mountpoint -q /mnt/rauc_update 2>/dev/null; then
                umount /mnt/rauc_update 2>/dev/null || umount -l /mnt/rauc_update 2>/dev/null || true
            fi
            
            echo "$NAME stopped."
            return $RETVAL
        fi
        # Stale PID file
        rm -f "$PIDFILE"
    fi
    
    # Ensure cleanup even without PID file
    pidof "$PROG" > /dev/null 2>&1 && {
        killall "$PROG" 2>/dev/null || true
        # Ensure unmount
        if mountpoint -q /mnt/rauc_update 2>/dev/null; then
            umount /mnt/rauc_update 2>/dev/null || umount -l /mnt/rauc_update 2>/dev/null || true
        fi
    }
    
    echo "$NAME is not running."
    return 0
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
            echo "$NAME (pid $PID) is running..."
            return 0
        fi
    fi
    
    # Check by program name
    if pidof "$PROG" > /dev/null 2>&1; then
        PID=$(pidof "$PROG")
        echo "$NAME (pid $PID) is running..."
        return 0
    fi
    
    echo "$NAME is stopped"
    return 3
}

reload() {
    echo "Reloading $NAME: Not supported, use restart"
    return 0
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    reload)
        reload
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload|status}"
        exit 1
        ;;
esac

exit $RETVAL
